            <div xml:id="1906_08_21_SD_LP_001">
                <p>En <trait type="character">stilla</trait>, <trait type="character">duglig</trait> och <trait type="character">ordentlig</trait>
                    <person sex="female" role="employee">jungfru</person> (<age type="approximate">ej under 25 år</age>), kan få en god och bra plats som <occupation>städerska</occupation> den <date when="1906-10-24" type="begin">24/10</date> å <placeName type="employment">villan Rahna</placeName>
                    <placeName type="employment" ref="#ramlösa">nära Ramlösa</placeName> om hon hänvänder sig til <state sex="female" role="mediator">fru Anna Henningsson</state>, <street type="application">Carlsgatan 45 a</street>, <placeName type="application" ref="#malmö">Malmö</placeName>. <idno type="advertisement">GAM 146972</idno>
                </p>
            </div>
