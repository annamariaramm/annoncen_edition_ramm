            <div xml:id="1906_11_29_SD_PS_001">
                <p>
                    <occupation>Sällskap och hjälp</occupation>. <age type="approximate">Ung</age>, <trait type="character">gladlynt</trait> och <trait type="character">barnkär</trait>
                    <person sex="female" role="employee">norrländska af god familj</person>
                    <placeName type="residence" ref="#norrland">norrländska</placeName> af god familj önskar <state type="requirement">mot fritt vivre</state> komma i <person sex="unspecified" role="employer">bättre familj</person> i <placeName type="employment" ref="#skane">mellersta eller södra Sverige</placeName> som sällskap och hjälp. Svar tacksamt till '<label>S– 1907</label>' under adr. <person sex="unspecified" role="mediator">S. Gumælii Annonsbyrå</person>, <placeName type="application" ref="#malmö">Malmö</placeName>. (<idno type="advertisement">G. 28351</idno>)</p>
