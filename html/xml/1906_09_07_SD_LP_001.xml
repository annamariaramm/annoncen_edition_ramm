            <div xml:id="1906_09_07_SD_LP_001">
                <p>
                    <person sex="female" role="employee">
                        <occupation>Ensamjungfru</occupation>
                    </person> söges til <date when="1906-11-01" type="begin">November</date> af et <placeName type="employment">Herskab med et större Börn</placeName>
                    <state type="requirement">Höj lön</state>. <trait type="skill">Madlavning</trait> fordres samt <ref type="reference">gode Anbefalinger</ref>. <person sex="unspecified" role="mediator">Ingeniör Borum</person>, <placeName type="application">Köbenhavns Vandværk</placeName>, <placeName type="application" ref="#köpenhamn">Köbenhavn</placeName>.</p>
