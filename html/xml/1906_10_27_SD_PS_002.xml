            <div xml:id="1906_10_27_SD_PS_002">
                <p>
                    <age type="approximate">Yngre</age>
                    <placeName type="residence" ref="#värmland">värmländska</placeName>, <trait type="skill">erfaren</trait> och <trait type="character">intresserad af et hems ordnande</trait>, önskar plats såsom <person sex="female" role="employee">
                        <occupation>värdinna</occupation>
                    </person> hos <person sex="male" role="employer">ungherre</person>, eller <person sex="female" role="employee">
                        <occupation>medhjälparinna</occupation>
                    </person> i <placeName type="employment">större hem</placeName> eller pensionat. Svar till '<label>Praktisk</label>', <placeName type="application" ref="#karlskoga">Karlskoga</placeName>
                    <address type="application">p. r.</address>
                </p>
            </div>
        </body>
