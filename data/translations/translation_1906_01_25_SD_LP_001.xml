                <div type="translation">
                    <p>Ein <state type="marital">unverheireter</state> <trait type="character">erfahrener</trait> <person sex="male" role="employee">
                        <occupation>Bediensteter</occupation>
                    </person>, am liebsten <age type="approximate">älter</age>, wird von einer <placeName type="employment">vornehmen Herrschaft</placeName> in <placeName type="employment" ref="#skane">Skåne</placeName> zum <date when="1906-05-01">1. Mai</date> gegen <measure type="salary">hohen Lohn</measure> gesucht. <person sex="unspecified" role="mediator">A. Bulling</person>, <placeName type="application" ref="#malmö">Malmö</placeName>. <idno type="advertisement">Rikst. 840</idno>. (<idno type="advertisement">STM 124089</idno>).
                    </p>
