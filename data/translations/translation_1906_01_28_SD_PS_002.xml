            <div xml:id="translation_1906_01_28_SD_PS_002">
                <div type="translation">
                    <p><age type="approximate">Ältere</age>, <trait type="character">erfahrene</trait> <person sex="female" role="employee">
                        <occupation>Haushälterin</occupation>
                    </person> <ref type="reference">mit guten Referenzen</ref>, <trait type="skill">erfahren sowohl in großen Landhaushalten als auch Stadthaushalten</trait>, sucht zum <date when="1906-04-24" type="begin">24. April</date> eine Stelle. Antowrten mit '<label>A. B. 42</label>', <address type="application">Büro dieser Zeitung</address>.
                    </p>
