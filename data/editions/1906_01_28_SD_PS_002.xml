            <div xml:id="1906_01_28_SD_PS_002">
                <p>
                    <age type="approximate">Äldre</age>, <trait type="character">erfaren</trait>
                    <person sex="female" role="employee">
                        <occupation>hushållerska</occupation>
                    </person>
                    <ref type="reference">med fina betyg</ref>, <trait type="skill">van vid stora landthushåll och äfven stadshushåll</trait>, söker plats till den <date when="1906-04-24" type="begin">24 April</date>. Svar till '<label>A. B. 42</label>', <address type="application">detta blads kontor</address>.</p>
