            <div xml:id="1906_07_29_SD_LP_005">
                <p>Ett <person sex="unspecified" role="employer">svenskt herrskap</person> vid <placeName type="employment" ref="#berlin">Berlin</placeName> önskar <date type="begin">helst genast</date> en <person sex="female" role="employee">
