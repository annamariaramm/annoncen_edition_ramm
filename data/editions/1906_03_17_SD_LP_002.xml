                <p>
                    <trait type="character">Dugliga</trait>
                    <person sex="female" role="employee">
                        <occupation>Kokerskor</occupation>
                    </person>, <person sex="female" role="employee">
                        <occupation>städerskor</occupation>
                    </person> och <person sex="female" role="employee">
                        <occupation>ensamjungfrur</occupation>
                    </person> få platser den <date when="1906-04-24" type="begin">24 April</date>. <person sex="unspecified" role="mediator">Lunds stads arbetsanskaffningsbyrå</person>
                    <placeName type="application" ref="#lund">Lund</placeName>s stads arbetsanskaffningsbyrå anvisar. <idno type="advertisement">LB 3187</idno>
                </p>
