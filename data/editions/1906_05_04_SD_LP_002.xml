            <div xml:id="1906_05_04_SD_LP_002">
                <p>En <age type="approximate">ej för ung</age>
                    <person sex="female" role="employee">flicka af aktningsvärd familj</person> (eller <age type="approximate">ung</age>
                    <person sex="female" role="employee">Enkefru</person>) kan få treflig sommarvistelse på naturskön egendom i <placeName type="employment" ref="#skane">Skåne</placeName>
                    <state type="requirement">mot fritt vivre</state>, som <occupation>sällskap</occupation> till <age type="approximate">ung</age>
                    <person sex="female" role="employer">fru</person>. Närmare i correspondens till '<label>Naturskön</label>' <address type="application">Gumælii Annonsb.</address>, <placeName type="application" ref="#malmö">Malmö</placeName>. <idno type="advertisement">GAM 142457</idno>
                </p>
            </div>
