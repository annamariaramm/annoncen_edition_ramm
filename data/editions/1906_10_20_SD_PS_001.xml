            <div xml:id="1906_10_20_SD_PS_001">
                <p>
                    <person sex="female" role="employee">
                        <occupation>Husföreståndarinneplats</occupation>
                    </person> sökes af <trait type="skill">fullt kompetent</trait>
                    <placeName type="residence" ref="#norrland">norrländska</placeName> som <trait type="experience">förut innehaft sådan anställning</trait>. Platsen sökes till <person sex="male" role="employer">änkemanshem</person>, pensionat eller hos <person sex="male" role="employer">ungherre</person>. Sökanden kan förete de allra <ref type="reference">bästa rekommendationer</ref>. Svar till '<label>Hemtrefnad</label>', <person sex="unspecified" role="mediator">Gumælii Annonsbyrå</person>, <placeName type="application" ref="#mamlö">Malmö</placeName>. GAM 150065</p>
            </div>
