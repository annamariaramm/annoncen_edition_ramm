    <text>
        <body>
            <div xml:id="1906_04_01_SD_PS_002">
                <p>
                    <state type="marital">Gift</state>, <age value="26">26-årig</age>
                    <trait type="character">proper</trait>
                    <person sex="male" role="employee">
                        <occupation>kusk</occupation>
                    </person>, <trait type="character">nykter</trait>, med <ref type="reference">utmärkta betyg från körskola i Malmö, och i öfrigt gods rekommendationer</ref>. <age value="40">40-årig</age>
                    <person sex="male" role="employee">
                        <occupation>ladugårdsfogde eller ladugårdsföreståndare</occupation>
                    </person>
                    <ref type="reference">med finaste betyg</ref> och <trait type="experience">mångårig praktik</trait> samt En <person sex="female" role="employee">
                        <occupation>hushållerska</occupation>
                    </person>
                    <ref type="reference">med bästa betyg och vitsord</ref>
                    <trait type="skill">att förestå större hushåll eller hotell</trait>, söka platser den <date when="1906-04-28" type="begin">24 April</date> genom <person sex="unspecified" role="mediator">Paul Åsps Kom.-Byrå</person>, <placeName type="application" ref="#skurup">Skurup</placeName>. <idno type="advertisement">STM 127398</idno>
                </p>
            </div>
