            <div xml:id="1906_12_23_SD_PS_001">
                <p>
                    <person sex="female" role="employee">
                        <occupation>Husföreståndarinna</occupation>
                    </person>
                    <trait type="character">praktisk</trait>, <trait type="skill">duglig i matlagning</trait>, <trait type="experience">fleårig att med ordning och trefnad förestå hem</trait> önskar plats <date when="1907-01-01" type="begin">på nyåret</date> hos <person sex="male" role="employer">aktad Enkling</person> eller <person sex="male" role="employer">ungherre</person>. <ref type="reference">God rek</ref> Svar till '<label>anspråkslös 380</label>' <address type="application">denna tidnings kontor</address>.</p>
            </div>
