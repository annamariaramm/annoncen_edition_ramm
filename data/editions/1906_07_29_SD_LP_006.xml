            <div xml:id="1906_07_29_SD_LP_006">
                <p>För en <trait type="character">ordentlig</trait> och <trait type="skill">i matlagning kunnig</trait>
                    <person sex="female" role="employee">
                        <occupation>kokerska</occupation>
                    </person> och en <person sex="female" role="employee">
                        <occupation>städerska</occupation>
                    </person> finnes god plats i <person sex="unspecified" role="employer">liten familj</person> den <date when="1906-10-24" type="begin">24 Okt.</date> Svar till <placeName type="application" ref="#hessleholm">Hessleholm</placeName>
                    <address type="application">p. r.</address>
                </p>
            </div>
