            <div xml:id="1906_07_27_SD_PS_002">
                <p>Plats önskas <date type="begin">till hösten</date> som <person sex="female" role="employee">
                        <occupation>kammarjungfru</occupation>
                    </person> eller <person sex="female" role="employee">
                        <occupation>frökenjungfru</occupation>
                    </person>, har <state type="skill">lärt kläd- och linnesöm samt strykning</state>, <ref type="reference">goda rekommendationer</ref> kunna företes. Svar bedes inlämnas <state type="requirement">jämte löneuppgift</state>
                    <state type="marital">gift</state> till '<label>Tacksam</label>' <address type="application">denna tidnings kontor</address>
                    <date type="apply">inom 10 dagar</date>.</p>
            </div>
        </body>
    </text>
