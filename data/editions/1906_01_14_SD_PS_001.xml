            <div xml:id="1906_01_14_SD_PS_001">
                <p>För en <age value="17">ung 17-års</age>
                    <person sex="female" role="employee">flicka</person>
                    <ref type="reference">af bättre familj</ref>, <state type="aim">villig att deltaga i alla inom hus förefallande göromål</state>
                    <state type="requirement">emot fritt vivre</state> sökes plats <date type="begin">genast eller till 1 februari</date>, helst i <placeName type="employment">prestgård eller annat bättre hem på landet</placeName>. Svar märkt '<label>Ung flicka</label>' <address type="application">poste restante</address>
                    <placeName type="application" ref="#engelholm">Engelholm</placeName>. <idno type="advertisement">GAM 136397</idno>.</p>
            </div>
