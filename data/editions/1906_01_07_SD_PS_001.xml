            <div xml:id="1906_01_07_SD_PS_001">
                <p>En <person sex="unspecified" role="employee">
                        <occupation>hushållselev</occupation>
                    </person> önskar plats å <placeName type="employment">större landtgård</placeName>, helst i <placeName type="employment">mellersta Sverige</placeName>
                    <date type="begin">fortast möjligt</date>. Svar <ref type="reference">med villkor</ref>
                    <date type="apply">inom 8 dagar</date> till '<label>L.</label>'', <address type="application">p. r.</address>
                    <placeName type="application" ref="#perstorp">Perstorp</placeName>, <placeName type="application" ref="#skane">Skåne</placeName>. <idno type="advertisement">LB 3011</idno>
