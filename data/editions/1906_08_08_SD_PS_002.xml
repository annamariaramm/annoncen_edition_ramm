            <div xml:id="1906_08_08_SD_PS_002">
                <p>
                    <person sex="female" role="employee">Bättre flicka</person>, som <trait type="experience">i ett par år innehaft plats att gå frun tillhanda</trait>, önskar <date type="begin">till hösten</date>
                    <state type="requirement">mot fritt vivre</state>
                    <state type="reason">få lära hushållet</state> å <placeName type="employment">större landtgård</placeName> eller <placeName type="employment">herregård</placeName>. <trait type="aim">Villig att deltaga i allt.</trait> Svar till '<label>Inga</label>' <address type="application">denna tidnings kontor</address>.</p>
            </div>
        </body>
