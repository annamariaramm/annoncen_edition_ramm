            <div xml:id="1906_09_05_SD_LP_001">
                <p>
                    <ref type="reference">Väl rek.</ref>
                    <person sex="female" role="employee">
                        <occupation>hushållerskor</occupation>
                    </person>, <person sex="female" role="employee">
                        <occupation>kokerskor</occupation>
                    </person>, <person sex="female" role="employee">
                        <occupation>ensamjungfrur</occupation>
                    </person> som <trait type="skill">laga god mat</trait>
                    <trait type="skill">vana</trait>
                    <person sex="female" role="employee">
                        <occupation>städerskor</occupation>
                    </person>, <person sex="female" role="employee">
                        <occupation>barnsköterskor</occupation>
                    </person>, <person sex="female" role="employee">
                        <occupation>tvätterskor</occupation>
                    </person>, <trait type="skill">kunniga i glansstrykning</trait>, m. fl., erhålla utmärkta platser i <date when="1906-10-01" type="begin">Okt.</date> till <placeName type="employment">städer och landet</placeName>. <ref type="reference">Ins. originalbetyg</ref>. Svar mot <measure type="porto" quantity="20" unit="öre">20 öre</measure>. <person sex="unspecified" role="mediator">Rydows agentur</person>, <street type="application">6 Davidshallsgatan</street>, <placeName type="application" ref="#malmö">Malmö</placeName>. <idno type="advertisement">STM 135202</idno>.</p>
            </div>
